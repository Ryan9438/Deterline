# OS files
.DS_Store
Thumbs.db

# Python
__pycache__/
*.pyc

# Backups (created by the tool)
*.bak

# Temp files
*.new

# Runtime artifacts (created by the tool)
*.snap.*
*.sandbox
*.sandbox.json

# Security-scanner hook artifacts (never commit; keeps release_check clean-tree gate usable)
# 故意不锚定根：hook 会在仓库根与子目录（scripts/ 等）生成；锚定根会让子目录产物打挂干净树闸门。
# 名称专用于扫描器状态（非源码目录），盲区可接受（R-A P3-1 登记）。
.mimosa/
.v2c/

# Game data / saves / runtime artifacts (never commit)
game.ios
file0
undertale.ini
*.bak*
*.snap*

# C3b vendor font binaries (OFL; download via assets/fonts/vendor, never commit)
assets/fonts/vendor/
build/
cjk_work/
.deterline/
rooms_scan.json
ROOMS_GUIDE.draft.md
